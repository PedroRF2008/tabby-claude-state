{
  "name": "tabby-claude-state",
  "version": "0.1.0",
  "description": "Shows Claude Code session state (working / waiting / done / error) on Tabby tabs, via an in-band OSC 1337 SetUserVar sent by Claude Code hooks. Works with WSL, SSH and local shells.",
  "keywords": [
    "tabby-plugin",
    "claude-code"
  ],
  "author": "pedrorf2008",
  "main": "dist/index.js",
  "files": [
    "dist",
    "hooks",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@angular/core": "*",
    "rxjs": "*",
    "tabby-core": "*",
    "tabby-terminal": "*"
  },
  "devDependencies": {
    "@angular/core": "^15.2.10",
    "@types/node": "^20.14.0",
    "rxjs": "^7.8.1",
    "tabby-core": "^1.0.231-nightly.0",
    "tabby-terminal": "^1.0.231-nightly.0",
    "typescript": "~5.4.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrorf2008/tabby-claude-state.git"
  },
  "homepage": "https://github.com/pedrorf2008/tabby-claude-state#readme",
  "bugs": {
    "url": "https://github.com/pedrorf2008/tabby-claude-state/issues"
  }
}
