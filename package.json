{
  "name": "tabby-claude-state",
  "version": "0.2.0",
  "description": "Claude Code session state on Tabby tabs: colours, progress, native notifications and a settings page that installs the hooks into WSL for you.",
  "keywords": [
    "tabby-plugin",
    "claude-code",
    "claude",
    "wsl",
    "notifications"
  ],
  "author": "pedrorf2008",
  "main": "dist/index.js",
  "files": [
    "dist",
    "hooks",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -p . --watch",
    "test": "node test/load.test.js && node test/middleware.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "license": "MIT",
  "peerDependencies": {
    "@angular/common": "*",
    "@angular/core": "*",
    "@angular/forms": "*",
    "rxjs": "*",
    "tabby-core": "*",
    "tabby-settings": "*",
    "tabby-terminal": "*"
  },
  "devDependencies": {
    "@angular/common": "^15.2.10",
    "@angular/core": "^15.2.10",
    "@angular/forms": "^15.2.10",
    "@types/node": "^20.14.0",
    "rxjs": "^7.8.1",
    "tabby-core": "^1.0.231-nightly.0",
    "tabby-settings": "^1.0.231-nightly.0",
    "tabby-terminal": "^1.0.231-nightly.0",
    "typescript": "~5.4.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedrorf2008/tabby-claude-state.git"
  },
  "homepage": "https://github.com/pedrorf2008/tabby-claude-state#readme",
  "bugs": {
    "url": "https://github.com/pedrorf2008/tabby-claude-state/issues"
  }
}
